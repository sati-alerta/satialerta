# ============================================================
# SATI-Alerta — Environment Variables
# Copie para .env e preencha com suas credenciais reais
# ============================================================

# Aplicação
APP_ENV=development
APP_URL=http://localhost/appSati-alerta
APP_KEY=sati_alerta_change_this_32chars_key
APP_DEBUG=true
APP_NAME=SATI-Alerta

# Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sati_alerta
DB_USER=root
DB_PASS=

# API Gateway ESP32 (chave secreta enviada no header X-API-Key pelo ESP32)
GATEWAY_API_KEY=sati_gateway_secret_key_change_this

# Twilio SMS
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+1xxxxxxxxxx

# OneSignal Push Notifications
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sessão
SESSION_LIFETIME=7200
SESSION_NAME=sati_session

# Timezone
APP_TIMEZONE=America/Manaus
